{
  "name": "reto-02-agente-contratos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional de registro de contratos vigentes: buzón único, extracción con confianza, maestro CSV, archivo tipo SharePoint y alertas.",
  "workspaces": ["web"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run src/server.ts",
    "build": "bun run --cwd web build",
    "demo": "bun run demo.ts",
    "sync:modulo": "bun run scripts/sync-modulo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
