# Google AI Studio: https://aistudio.google.com/apikey  (formato típico: AIza...)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Proveedor LLM: auto | gemini | offline | openai | anthropic
# auto = Gemini si hay GOOGLE_API_KEY, si no offline (heurístico + planificador local)
LLM_PROVIDER=auto

# Pon 1 solo si quieres forzar modo offline (sin llamar a Gemini).
GEMINI_FORCE_OFFLINE=0

# Stubs (completar adapters/llm/stubs.ts + instalar @langchain/openai|anthropic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

REFERENCE_DATE=2026-05-30
CONFIDENCE_THRESHOLD=0.8

# Backend Hono (bun run api)
API_PORT=8787
