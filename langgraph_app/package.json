{
  "name": "reto-02-agente-contratos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional TypeScript/Bun: clasifica correos, extrae contratos con confianza, actualiza maestro SharePoint simulado, archiva y reporta vencimientos (LangGraph + Gemini).",
  "scripts": {
    "start": "bun run src/cli.ts",
    "api": "bun run src/api/server.ts",
    "web": "bun --cwd ../web run dev",
    "demo": "bun run src/demo.ts",
    "process": "bun run src/demo.ts",
    "report": "bun run src/cli.ts --report",
    "reset": "bun run src/cli.ts --reset",
    "smoke": "bun run src/smoke.ts",
    "smoke:api": "bun run src/smoke-api.ts",
    "studio": "bunx @langchain/langgraph-cli dev",
    "dev": "bunx @langchain/langgraph-cli dev",
    "typecheck": "tsc --noEmit"
  },

  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/google": "^0.2.14",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-cli": "^1.7.1",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
