# Opcional. Sin API key el agente usa un extractor heurístico (reglas + regex) y corre 100% offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Fecha de referencia para alertas de vencimiento (el maestro está congelado al 30-may-2026).
REFERENCE_DATE=2026-05-30

# Umbral de confianza mínima para escribir en el maestro sin revisión humana.
CONFIDENCE_THRESHOLD=0.8
