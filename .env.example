# Copia este archivo a .env y completa los valores. Ninguna variable es obligatoria para arrancar:
# sin GOOGLE_API_KEY el backend usa el proveedor offline (guion determinista sobre las mismas herramientas).

# Proveedor LLM: auto (Gemini si hay clave, si no offline) | gemini | offline
LLM_PROVIDER=
# Clave de Google AI Studio (Gemini). Solo vive en el backend; nunca llega al front, los logs ni la API.
GOOGLE_API_KEY=
# Modelo de Gemini (por defecto gemini-2.5-flash)
GEMINI_MODEL=
# Timeout por llamada al proveedor en milisegundos (por defecto 60000)
LLM_TIMEOUT_MS=

# Topes de costo: iteraciones modelo→herramientas por turno (25), tokens por sesión (300000) y por proceso (3000000)
MAX_ITERACIONES=
MAX_TOKENS_SESION=
MAX_TOKENS_PROCESO=

# Puerto del backend (por defecto 3000; Vite en 5173 hace proxy de /api a este puerto)
PORT=
