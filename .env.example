# Copia este archivo a .env y completa los valores. Ninguna variable es obligatoria para arrancar:
# sin GOOGLE_API_KEY el backend usa el proveedor offline (guion determinista sobre las mismas herramientas).

# Proveedor LLM: auto (Gemini si hay clave, si no offline) | gemini | offline
LLM_PROVIDER=
# Clave de Google AI Studio (Gemini). Solo vive en el backend; nunca llega al front, los logs ni la API.
GOOGLE_API_KEY=
# Modelo de Gemini (por defecto gemini-2.5-flash)
GEMINI_MODEL=
# Timeout por llamada al proveedor en milisegundos (por defecto 60000)
LLM_TIMEOUT_MS=
# Reintentos ante fallos transitorios del proveedor (429, 5xx o red; no ante timeout), con espera exponencial (por defecto 2, máx. 5)
LLM_REINTENTOS=

# Topes de costo: iteraciones modelo→herramientas por turno (25), tokens por sesión (300000) y por proceso (3000000)
MAX_ITERACIONES=
MAX_TOKENS_SESION=
MAX_TOKENS_PROCESO=

# Puerto del backend (por defecto 3000; Vite en 5173 hace proxy de /api a este puerto)
PORT=

# Despliegue con front separado (Vercel → AWS): orígenes autorizados por CORS en el backend, separados por coma
CORS_ORIGINS=
# Solo en el build del front (Vercel): URL pública del backend. Vacío = mismo origen (local / imagen única)
VITE_API_URL=

# Servidor de LangGraph (studio/) que la API publica en /langgraph para abrirlo en LangGraph Studio desde la web.
# Vacío: no se publica. En local, con `bun run studio` corriendo: http://127.0.0.1:2024. La imagen Docker lo trae
# activado (http://127.0.0.1:2024) y levanta ese servidor ella misma; vacíalo para no levantarlo.
LANGGRAPH_URL=
